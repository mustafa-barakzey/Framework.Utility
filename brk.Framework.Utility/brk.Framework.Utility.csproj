<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <!-- Package Metadata -->
        <PackageId>brk.Framework.Utility</PackageId>
        <Description>A lightweight .NET utility library providing extension methods, validators, date/time helpers, culture utilities, and reflection helpers.</Description>
        <PackageDescription>A lightweight .NET utility library that provides reusable extension methods and helper classes for strings, numbers, enums, dates, Persian calendar support, validation (email, mobile, national ID), culture, and reflection utilities.</PackageDescription>

        <!-- Recommended additions -->
        <PackageTags>utility;extensions;helpers;validation;datetime;persian-calendar;string;number;enum;reflection;culture;email;mobile;nationalid;dotnet;framework</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        
        <!-- Shared Author Info -->
        <Version>1.1.0</Version>
        <Authors>Mustafa Barakzey (mustafabarakzey@gmail.com)</Authors>
        <Company>mustafa-barakzey</Company>
        <Copyright>Copyright © Mustafa Barakzey 2026</Copyright>
        <RepositoryUrl>https://github.com/mustafa-barakzey/Framework.Utility</RepositoryUrl>
        <PackageProjectUrl>https://github.com/mustafa-barakzey/Framework.Utility</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <!-- Optional: Source Link for debugging -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    </PropertyGroup>

    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="\" />
        <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
